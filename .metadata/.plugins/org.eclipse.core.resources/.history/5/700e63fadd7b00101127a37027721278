<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<html>
<head>
    <title>주문 목록</title>
</head>
<body>
<h2>주문 목록</h2>
<table border="1">
    <tr>
        <th>주문번호</th>
        <th>고객ID</th>
        <th>주문일자</th>
        <th>상태</th>
        <th>총금액</th>
        <th>관리</th>
    </tr>
    <c:forEach var="o" items="${orders}">
        <tr>
            <td>${o.orderId}</td>
            <td>${o.customerId}</td>
            <td>${o.orderDate}</td>
            <td>${o.status}</td>
            <td>${o.totalAmount}</td>
            <td>
                <a href="OrderServlet?action=delete&id=${o.orderId}">삭제</a>
            </td>
        </tr>
    </c:forEach>
</table>
</body>
</html>
