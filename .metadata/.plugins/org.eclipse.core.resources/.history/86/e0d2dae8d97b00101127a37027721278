<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="com.erp.dao.ProductDAO" %>
<%@ page import="com.erp.model.Product" %>
<%@ page import="java.sql.SQLException" %>
<%@ page import="java.util.logging.Level" %>
<%@ page import="java.util.logging.Logger" %>

<%!
    private static final Logger LOGGER = Logger.getLogger("ProductEditProcessLogger");
%>

<%
    request.setCharacterEncoding("UTF-8");

    String pidStr = request.getParameter("pid");
    String pname = request.getParameter("pname");
    String priceStr = request.getParameter("price");
    String stockStr = request.getParameter("stock");

    // 입력값 검증
    if (pidStr == null || pname == null || pname.trim().isEmpty() || priceStr == null || stockStr == null) {
        response.sendRedirect("product_edit.jsp?pid=" + pidStr + "&error=1");
        return;
    }

    int pid;
    double price;
    int stock;

    try {
        pid = Integer.parseInt(pidStr);
    } catch (NumberFormatException e) {
        response.sendRedirect("product_list.jsp");
        return;
    }

    try {
        price = Double.parseDouble(priceStr);
        if (price < 0) {
            response.sendRedirect("product_edit.jsp?pid=" + pid + "&error=2");
            return;
        }
    } catch (NumberFormatException e) {
        response.sendRedirect("product_edit.jsp?pid=" + pid + "&error=2");
        return;
    }

    try {
        stock = Integer.parseInt(stockStr);
        if (stock < 0) {
            response.sendRedirect("product_edit.jsp?pid=" + pid + "&error=3");
            return;
        }
    } catch (NumberFormatException e) {
        response.sendRedirect("product_edit.jsp?pid=" + pid + "&error=3");
        return;
    }

    // 상품 객체 생성 및 데이터베이스 업데이트
    Product product = new Product(pname.trim(), price, stock);
    product.setPid(pid);
    ProductDAO productDAO = new ProductDAO();

    try {
        productDAO.updateProduct(product);
        response.sendRedirect("product_edit.jsp?pid=" + pid + "&success=1");
    } catch (SQLException e) {
        LOGGER.log(Level.SEVERE, "Database error during product update", e);
        response.sendRedirect("product_edit.jsp?pid=" + pid + "&error=4");
    }
%>