
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.sql.*" %>
<%@ page import="com.company1.DBManager" %>
<%
// 페이지네이션 및 검색 기능을 위한 변수 설정
// 페이지 번호와 페이지 크기 설정

// 페이지네이션 및 검색 기능을 위한 변수 설정
int page = 1; // 여기
int pageSize = 10; // Items per page
String search = request.getParameter("search");

if (request.getParameter("page") != null) {
    page = Integer.parseInt(request.getParameter("page"));
}
int startRow = (page - 1) * pageSize;
%>

int pageSize = 10; // Items per page
String search = request.getParameter("search");

if (request.getParameter("page") != null) {
    page = Integer.parseInt(request.getParameter("page"));
}
int startRow = (page - 1) * pageSize;
%>

int pageSize = 10; // 한 페이지당 표시 수
String search = request.getParameter("search");
if(request.getParameter("page") != null) {
    page = Integer.parseInt(request.getParameter("page"));
}
int startRow = (page - 1) * pageSize;

Connection conn = null;
PreparedStatement pstmt = null;
ResultSet rs = null;
ResultSet rsCount = null;

int totalRows = 0;

try {
    conn = DBManager.getDBConnection();

    // 총 상품 수 (검색 포함)
    String countSql = "SELECT COUNT(*) FROM products";
    if(search != null && !search.isEmpty()) {
        countSql += " WHERE name LIKE ?";
    }
    pstmt = conn.prepareStatement(countSql);
    if(search != null && !search.isEmpty()) {
        pstmt.setString(1, "%" + search + "%");
    }
    rsCount = pstmt.executeQuery();
    if(rsCount.next()) totalRows = rsCount.getInt(1);
    pstmt.close();

    // 상품 조회 (검색 + 페이징)
    String sql = "SELECT * FROM products";
    if(search != null && !search.isEmpty()) {
        sql += " WHERE name LIKE ?";
    }
    sql += " ORDER BY id ASC LIMIT ?, ?";

    pstmt = conn.prepareStatement(sql);
    int idx = 1;
    if(search != null && !search.isEmpty()) {
        pstmt.setString(idx++, "%" + search + "%");
    }
    pstmt.setInt(idx++, startRow);
    pstmt.setInt(idx++, pageSize);

    rs = pstmt.executeQuery();
%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>상품 목록</title>
<style>
table { border-collapse: collapse; width: 80%; margin: auto; }
th, td { border: 1px solid #ccc; padding: 8px; text-align: center; }
th { background-color: #f0f0f0; }
.pagination { text-align:center; margin-top:20px; }
.pagination a { margin: 0 5px; text-decoration:none; }
form { display:inline; }
</style>
</head>
<body>
<h2 style="text-align:center;">상품 목록</h2>

<!-- 검색 -->
<form method="get" action="product_list.jsp" style="text-align:center; margin-bottom:10px;">
    <input type="text" name="search" value="<%= (search!=null)?search:"" %>" placeholder="상품명 검색">
    <input type="submit" value="검색">
</form>

<table>
<tr>
    <th>상품번호</th>
    <th>상품명</th>
    <th>가격</th>
    <th>재고</th>
    <th>관리</th>
</tr>
<%
while(rs.next()) {
%>
<tr>
    <td><%= rs.getInt("id") %></td>
    <td><%= rs.getString("name") %></td>
    <td><%= rs.getInt("price") %>원</td>
    <td><%= rs.getInt("stock") %></td>
    <td>
        <!-- 수정/삭제 -->
        <a href="product_edit.jsp?id=<%= rs.getInt("id") %>">수정</a> |
        <a href="ProductServlet?action=delete&id=<%= rs.getInt("id") %>">삭제</a> |

        <!-- 바로 주문 -->
        <form action="OrderServlet" method="post">
            <input type="hidden" name="productId" value="<%= rs.getInt("id") %>">
            <input type="number" name="quantity" min="1" max="<%= rs.getInt("stock") %>" value="1" required>
            <input type="submit" value="주문" <%= rs.getInt("stock")==0 ? "disabled" : "" %>>
        </form>
    </td>
</tr>
<%
}
%>
</table>

<!-- 페이징 -->
<div class="pagination">
<%
int totalPages = (int)Math.ceil((double)totalRows / pageSize);
for(int i=1; i<=totalPages; i++) {
    if(i==page) {
        out.print("<b>"+i+"</b>");
    } else {
        out.print("<a href='product_list.jsp?page="+i+(search!=null?"&search="+search:"")+"'>"+i+"</a>");
    }
}
%>
</div>

<div style="text-align:center; margin-top:20px;">
    <a href="order_list.jsp">주문 내역 확인</a>
</div>

</body>
</html>
<%
} catch(Exception e) {
    e.printStackTrace();
} finally {
    DBManager.close(rs, pstmt, conn);
    DBManager.close(rsCount, null, null);
}
%>