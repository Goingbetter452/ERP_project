<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="com.erp.dao.ProductDAO" %>
<%@ page import="com.erp.model.Product" %>
<%@ page import="java.sql.SQLException" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>상품 수정 - 상품관리 시스템</title>
<link rel="stylesheet" type="text/css" href="css/style.css">
</head>
<body>
    <div class="container">
        <h1>상품 수정</h1>
        <div class="menu">
            <a href="index.jsp" class="btn">메인 페이지</a>
            <a href="product_list.jsp" class="btn">상품 목록</a>
        </div>
        
        <%
            String pidStr = request.getParameter("pid");
            Product product = null;
            String errorMessage = null;
            
            if (pidStr != null) {
                try {
                    int pid = Integer.parseInt(pidStr);
                    ProductDAO productDAO = new ProductDAO();
                    product = productDAO.getProductById(pid);
                    
                    if (product == null) {
                        errorMessage = "해당 상품을 찾을 수 없습니다.";
                    }
                } catch (NumberFormatException e) {
                    errorMessage = "잘못된 상품 번호입니다.";
                } catch (SQLException e) {
                    errorMessage = "데이터베이스 오류가 발생했습니다.";
                }
            } else {
                errorMessage = "상품 번호가 필요합니다.";
            }
            
            String updateError = request.getParameter("error");
            String success = request.getParameter("success");
            
            if (updateError != null) {
                String updateErrorMessage = "";
                switch (updateError) {
                    case "1":
                        updateErrorMessage = "모든 필드를 입력해주세요.";
                        break;
                    case "2":
                        updateErrorMessage = "올바른 가격을 입력해주세요.";
                        break;
                    case "3":
                        updateErrorMessage = "올바른 재고 수량을 입력해주세요.";
                        break;
                    case "4":
                        updateErrorMessage = "데이터베이스 오류가 발생했습니다.";
                        break;
                    default:
                        updateErrorMessage = "알 수 없는 오류가 발생했습니다.";
                        break;
                }
                out.println("<p class='error-message'>" + updateErrorMessage + "</p>");
            }
            
            if (success != null && success.equals("1")) {
                out.println("<p class='success-message'>상품이 성공적으로 수정되었습니다!</p>");
            }
        %>
        
        <div class="main-content">
            <% if (errorMessage != null) { %>
                <p class="error-message"><%= errorMessage %></p>
                <a href="product_list.jsp" class="btn">상품 목록으로 돌아가기</a>
            <% } else if (product != null) { %>
                <form action="product_edit_process.jsp" method="post" class="product-form">
                    <input type="hidden" name="pid" value="<%= product.getPid() %>">
                    
                    <div class="form-group">
                        <label for="pname">상품명:</label>
                        <input type="text" id="pname" name="pname" value="<%= product.getPname() %>" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="price">가격:</label>
                        <input type="number" id="price" name="price" value="<%= product.getPrice() %>" min="0" step="0.01" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="stock">재고 수량:</label>
                        <input type="number" id="stock" name="stock" value="<%= product.getStock() %>" min="0" required>
                    </div>
                    
                    <div class="form-group">
                        <input type="submit" value="상품 수정" class="btn">
                        <a href="product_list.jsp" class="btn btn-secondary">취소</a>
                    </div>
                </form>
            <% } %>
        </div>
    </div>
</body>
</html>