package servlet;

import java.io.IOException;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import javax.servlet.*;
import javax.servlet.http.*;

import com.company1.DBManager;

/**
 * ProductServlet: 상품 관리와 관련된 요청을 처리하는 서블릿.
 * GET 요청과 POST 요청을 구분하여 상품 목록 조회, 등록, 수정, 삭제 기능을 수행합니다.
 * @WebServlet 어노테이션은 서블릿 3.0 이상에서 web.xml 설정 없이 URL 매핑을 가능하게 합니다.
 */
public class ProductServlet extends HttpServlet {

    /**
     * 클라이언트로부터 GET 요청을 받을 때 실행됩니다.
     * 주로 데이터를 조회하거나 페이지를 보여줄 때 사용됩니다.
     */
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        
        // URL에서 "action" 파라미터 값을 가져옵니다. (예: ?action=list)
        String action = request.getParameter("action");
        if (action == null) {
            action = "list"; // 파라미터가 없으면 기본값으로 "list"를 설정합니다.
        }

        // action 값에 따라 다른 메서드를 호출하여 기능을 분기합니다.
        switch(action) {
            case "list":
                listProducts(request, response); // 상품 목록 조회 기능
                break;
            case "delete":
                deleteProduct(request, response); // 상품 삭제 기능
                break;
            case "edit":
                editProductForm(request, response); // 상품 수정 폼 보여주기
                break;
            default:
                listProducts(request, response); // 그 외의 경우, 목록 조회
                break;
        }
    }

    /**
     * 클라이언트로부터 POST 요청을 받을 때 실행됩니다.
     * 주로 폼 데이터를 받아와서 데이터베이스에 변경사항을 반영할 때 사용됩니다.
     */
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        
        // 폼에서 넘어온 "action" 파라미터 값을 가져옵니다.
        String action = request.getParameter("action");

        if ("insert".equals(action)) {
            insertProduct(request, response); // 상품 등록 기능
        } else if ("update".equals(action)) {
            updateProduct(request, response); // 상품 수정 처리 기능
        } else {
            doGet(request, response); // action이 없거나 다른 값일 경우 GET 요청으로 처리
        }
    }

    //----------------------------------------------------------------------------------
    // 아래부터는 각 기능별로 분리된 개별 메서드입니다.
    //----------------------------------------------------------------------------------

    /**
     * 데이터베이스에서 상품 목록을 조회하고, product_list.jsp로 포워드합니다.
     */
    private void listProducts(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        
        // SQL 쿼리: products 테이블의 모든 데이터를 가져옵니다.
        String sql = "SELECT * FROM products";
        
        // try-with-resources 문법으로 Connection, PreparedStatement, ResultSet을 자동으로 닫습니다.
        try (Connection conn = DBManager.getDBConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql);
             ResultSet rs = pstmt.executeQuery()) {

            // 조회된 ResultSet 객체를 "productList"라는 이름으로 request에 저장합니다.
            // 이렇게 저장된 데이터는 product_list.jsp에서 <%= %> 스크립틀릿으로 사용할 수 있습니다.
            request.setAttribute("productList", rs);
            
            // "product_list.jsp"로 요청과 응답을 전달하여 화면을 표시합니다.
            RequestDispatcher dispatcher = request.getRequestDispatcher("product_list.jsp");
            dispatcher.forward(request, response);

        } catch (SQLException e) {
            // SQL 오류가 발생하면 콘솔에 로그를 출력합니다.
            e.printStackTrace();
        }
    }

    /**
     * 폼에서 받은 데이터를 이용해 새로운 상품을 데이터베이스에 등록합니다.
     */
    private void insertProduct(HttpServletRequest request, HttpServletResponse response)
            throws IOException {
        
        // 폼에서 넘어온 파라미터 값들을 가져옵니다.
        String pname = request.getParameter("pname");
        double price = Double.parseDouble(request.getParameter("price"));
        int stock = Integer.parseInt(request.getParameter("stock"));

        // SQL 쿼리: 상품명을 포함한 데이터를 삽입합니다.
        String sql = "INSERT INTO products(pname, price, stock) VALUES (?, ?, ?)";
        
        try (Connection conn = DBManager.getDBConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {

            // SQL 파라미터에 값을 바인딩합니다.
            pstmt.setString(1, pname);
            pstmt.setDouble(2, price);
            pstmt.setInt(3, stock);
            
            // 쿼리를 실행하여 데이터베이스에 반영합니다.
            pstmt.executeUpdate();
            
        } catch (SQLException e) {
            e.printStackTrace();
        }
        
        // 등록이 완료되면 상품 목록 페이지로 다시 이동합니다.
        response.sendRedirect("ProductServlet?action=list");
    }

    /**
     * 특정 상품 ID를 이용해 데이터베이스에서 상품 정보를 삭제합니다.
     */
    private void deleteProduct(HttpServletRequest request, HttpServletResponse response)
            throws IOException {
        
        // URL 파라미터에서 삭제할 상품의 ID를 가져옵니다.
        int pid = Integer.parseInt(request.getParameter("pid"));
        
        // SQL 쿼리: 특정 pid를 가진 행을 삭제합니다.
        String sql = "DELETE FROM products WHERE pid=?";
        
        try (Connection conn = DBManager.getDBConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {
            
            pstmt.setInt(1, pid);
            pstmt.executeUpdate();
            
        } catch (SQLException e) {
            e.printStackTrace();
        }
        
        // 삭제가 완료되면 상품 목록 페이지로 이동합니다.
        response.sendRedirect("ProductServlet?action=list");
    }

    /**
     * 특정 상품 ID를 이용해 상품 수정 폼에 보여줄 데이터를 조회합니다.
     */
    private void editProductForm(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        
        // URL 파라미터에서 수정할 상품의 ID를 가져옵니다.
        int pid = Integer.parseInt(request.getParameter("pid"));
        
        // SQL 쿼리: 특정 pid를 가진 상품 정보를 조회합니다.
        String sql = "SELECT * FROM products WHERE pid=?";
        
        try (Connection conn = DBManager.getDBConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {

            pstmt.setInt(1, pid);
            ResultSet rs = pstmt.executeQuery();
            
            if(rs.next()) { // 데이터가 존재하면
                request.setAttribute("product", rs); // ResultSet을 request에 저장
                // product_edit.jsp로 전달하여 수정 폼을 보여줍니다.
                RequestDispatcher dispatcher = request.getRequestDispatcher("product_edit.jsp");
                dispatcher.forward(request, response);
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }

    /**
     * 폼에서 받은 데이터로 기존 상품 정보를 업데이트합니다.
     */
    private void updateProduct(HttpServletRequest request, HttpServletResponse response)
            throws IOException {
        
        // 폼에서 넘어온 파라미터 값들을 가져옵니다.
        int pid = Integer.parseInt(request.getParameter("pid"));
        String pname = request.getParameter("pname");
        double price = Double.parseDouble(request.getParameter("price"));
        int stock = Integer.parseInt(request.getParameter("stock"));

        // SQL 쿼리: 특정 pid를 가진 행의 데이터를 수정합니다.
        String sql = "UPDATE products SET pname=?, price=?, stock=? WHERE pid=?";
        
        try (Connection conn = DBManager.getDBConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {

            pstmt.setString(1, pname);
            pstmt.setDouble(2, price);
            pstmt.setInt(3, stock);
            pstmt.setInt(4, pid);
            pstmt.executeUpdate();
            
        } catch (SQLException e) {
            e.printStackTrace();
        }
        
        // 수정이 완료되면 상품 목록 페이지로 돌아갑니다.
        response.sendRedirect("ProductServlet?action=list");
    }
}