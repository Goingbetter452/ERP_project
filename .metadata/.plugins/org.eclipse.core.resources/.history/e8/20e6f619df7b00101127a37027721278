package com.erp.dao;

import com.erp.model.Order;
import com.erp.model.OrderItem;
import com.erp.util.DBManager;
import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class OrderDAO {

    // 주문 등록
    public int insertOrder(Order order) {
        String sql = "INSERT INTO orders (customer_id, total_amount) VALUES (?, ?)";
        try (Connection conn = DBManager.getConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql, Statement.RETURN_GENERATED_KEYS)) {

            pstmt.setInt(1, order.getCustomerId());
            pstmt.setDouble(2, order.getTotalAmount());
            pstmt.executeUpdate();

            ResultSet rs = pstmt.getGeneratedKeys();
            if (rs.next()) {
                return rs.getInt(1); // 생성된 order_id 반환
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        return -1;
    }

    // 주문 상세 등록
    public void insertOrderItems(List<OrderItem> items, int orderId) {
        String sql = "INSERT INTO order_items (order_id, product_id, quantity, price) VALUES (?, ?, ?, ?)";
        try (Connection conn = DBManager.getConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {

            for (OrderItem item : items) {
                pstmt.setInt(1, orderId);
                pstmt.setInt(2, item.getProductId());
                pstmt.setInt(3, item.getQuantity());
                pstmt.setDouble(4, item.getPrice());
                pstmt.addBatch();
            }
            pstmt.executeBatch();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // 주문 목록 조회
    public List<Order> getAllOrders() {
        List<Order> list = new ArrayList<>();
        String sql = "SELECT * FROM orders";
        try (Connection conn = DBManager.getConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql);
             ResultSet rs = pstmt.executeQuery()) {

            while (rs.next()) {
                Order o = new Order();
                o.setOrderId(rs.getInt("order_id"));
                o.setCustomerId(rs.getInt("customer_id"));
                o.setOrderDate(rs.getTimestamp("order_date"));
                o.setStatus(rs.getString("status"));
                o.setTotalAmount(rs.getDouble("total_amount"));
                list.add(o);
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        return list;
    }

    // 주문 상태 변경
    public void updateStatus(int orderId, String status) {
        String sql = "UPDATE orders SET status=? WHERE order_id=?";
        try (Connection conn = DBManager.getConnection();
             PreparedStatement pstmt = conn.prepareStatement(sql)) {
            pstmt.setString(1, status);
            pstmt.setInt(2, orderId);
            pstmt.executeUpdate();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // 주문 삭제
    public void deleteOrder(int orderId) {
        try (Connection conn = DBManager.getConnection()) {
            PreparedStatement pstmt1 = conn.prepareStatement("DELETE FROM order_items WHERE order_id=?");
            pstmt1.setInt(1, orderId);
            pstmt1.executeUpdate();

            PreparedStatement pstmt2 = conn.prepareStatement("DELETE FROM orders WHERE order_id=?");
            pstmt2.setInt(1, orderId);
            pstmt2.executeUpdate();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
